# Microsoft Dataverse / Entra ID confidential-client app
# Register an app in Entra ID, create a client secret, then assign an
# Application User in Power Platform admin center with read/write on
# entity + attribute metadata (e.g. System Customizer).
DATAVERSE_TENANT_ID=
DATAVERSE_CLIENT_ID=
DATAVERSE_CLIENT_SECRET=
DATAVERSE_ENVIRONMENT_URL=yourorg.crm16.dynamics.com

# Optional path overrides (defaults derive from the repo root)
# KI_FM_DATA_DIR=./data
# KI_FM_OUTPUT_DIR=./output

# Optional throughput tuning
# KI_FM_MAX_WORKERS=4
# KI_FM_MAX_RETRIES=8

# GitHub PAT — only needed locally if you automate repository operations;
# never commit this value.
# GITHUB_TOKEN=
